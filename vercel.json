{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "bun install --frozen-lockfile",
  "framework": null,
  "redirects": [
    {
      "source": "/services/iv-therapy",
      "destination": "/services",
      "statusCode": 301
    },
    {
      "source": "/services/weight-loss",
      "destination": "/services",
      "statusCode": 301
    },
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/peptidetherapy",
      "destination": "/services/peptide-therapy",
      "statusCode": 301
    },
    {
      "source": "/progesteroneestrogen",
      "destination": "/services/progesterone-estrogen",
      "statusCode": 301
    }
  ]
}
